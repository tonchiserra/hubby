# Copiar a .env.local y completar con los valores del proyecto de Supabase.
# Project Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Nomenclatura nueva de Supabase: reemplaza a la vieja "anon key".
# Es pública por diseño — lo que protege los datos es RLS, no ocultar esta clave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
